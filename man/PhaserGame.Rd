\subsection{Method \code{add_overlap()}}{
Adds a collider between two game objects.
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{PhaserGame$add_overlap(
  object_one,
  object_two = NULL,
  group = NULL,
  browser_action = browser_actions(),
  input = NULL,
  server_action = NULL,
  mode = c("enter", "stay"),
  interval = 0
)}\if{html}{\out{</div>}}
}

